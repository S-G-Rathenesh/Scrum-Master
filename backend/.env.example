# ==========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ==========================================
ENVIRONMENT=development
PROJECT_NAME="Scrum Master API"
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=scrum_master

# ==========================================
# PRODUCTION CONFIGURATION (Example)
# ==========================================
# ENVIRONMENT=production
# FRONTEND_URL=https://scrummaster.rathenesh.dev
# BACKEND_URL=https://api.scrummaster.rathenesh.dev
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/scrum_master

# ==========================================
# SECRETS (Required for both)
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
